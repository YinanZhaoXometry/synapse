# The api's config surface is ENV-only (AD-12/AD-20). In local dev,
# backend/.dockerdev/compose.yaml sets these — this file documents the contract.
DATABASE_URL=postgres://postgres:postgres@db:5432/backend_development
RAILS_ENV=development
# Session-token signing secret (HS256) — Accounts::TokenCodec (AD-15, epic
# P2-2 ticket 01). The dev compose wires a fixed dev-only default; outside
# dev, set a real random secret (e.g. `rails secret`). Rotating it invalidates
# every outstanding token (stateless — AD-15 accepted risk).
JWT_SECRET=
