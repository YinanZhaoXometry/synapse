# The api's config surface is ENV-only (AD-12/AD-20). In local dev,
# backend/.dockerdev/compose.yaml sets these — this file documents the contract.
DATABASE_URL=postgres://postgres:postgres@db:5432/backend_development
RAILS_ENV=development
# Session-token signing secret (HS256) — Accounts::TokenCodec (AD-15, epic
# P2-2 ticket 01). The dev compose wires a fixed dev-only default; outside
# dev, set a real random secret (e.g. `rails secret`). Rotating it invalidates
# every outstanding token (stateless — AD-15 accepted risk).
JWT_SECRET=
# Login rate limiting (AD-15, epic P2-2 ticket 02) — Accounts::LoginRateLimiter.
# Both optional: when absent, blank, or garbage they fall back to the defaults
# shown (threshold = admitted login attempts per email per fixed window;
# window = window length in seconds). The limiter also sheds untracked keys
# above a hard in-memory cap (MAX_KEYS, code constant — not ENV-configurable).
# LOGIN_RATE_LIMIT_THRESHOLD=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Demo account seeded by db/seeds.rb (epic P2-2 ticket 03) — idempotent on
# every db:seed run. DEMO_EMAIL is downcased before create; DEMO_PASSWORD
# must be at least 8 characters (register-command parity). Dev/test fall
# back to demo@synapse.test / demo-password when these are absent or blank;
# production fails fast instead — set real values there.
DEMO_EMAIL=
DEMO_PASSWORD=
# Object storage (AD-13, epic P2-6 ticket 01) — ActiveStorage → S3-compatible
# endpoints. dev/test run the compose minio service: endpoint/bucket are
# pinned in backend/config/storage.yml (endpoint http://minio:9000, bucket
# synapse-materials) and access/secret fall back to the dev defaults
# synapse-dev / synapse-dev-password (compose's MINIO_ROOT_USER/PASSWORD must
# stay aligned). Production runs Cloudflare R2 — every value MUST come from
# ENV there with NO defaults; config/environments/production.rb fails fast at
# boot when any of the four is missing. Provisioning: epic P2-6 ticket 03.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# AI provider (AD-16, epic P2-5 ticket 01) — OpenAI-compatible chat
# completions, GLM first (OQ-4). PROVIDER_KEY is the only required value:
# blank means "provider not configured" and every AI surface returns
# INTERNAL (the pre-cutover dev/test state — the web still runs the
# simulated adapter until epic P2-8). Base URL/model/timeout are optional
# with the defaults shown; a provider swap is config, not code. One manual
# live probe per config change: `bin/rails ai:probe` (S6 pattern — never in
# CI). Provider terms verification is the owner's OQ-4 gate (roadmap).
PROVIDER_KEY=
# PROVIDER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# PROVIDER_MODEL=glm-4-flash
# PROVIDER_TIMEOUT_SECONDS=120
# Per-user daily AI cost cap (AD-16/FR-34/NFR-4, epic P2-5 ticket 02) —
# enforced inside the Ai::Provider seam at the adapter boundary. Calls/day
# counts every provider call including a stream restart after a drop
# (deliberate double-count, AD-16); the context-in bound is a token
# ESTIMATE (3 chars/token — see Ai::ContextAssembler) that deterministically
# truncates assembled material. Both optional with the defaults shown.
# AI_DAILY_CALL_CAP=50
# AI_CONTEXT_BUDGET_TOKENS=8000
# Stream tickets (AD-16, epic P2-5 ticket 04): the single-use SSE secret's
# TTL in seconds (~60s per the spine; expired/replayed tickets get 401).
# AI_STREAM_TICKET_TTL_SECONDS=60
# CORS origin allowlist (AD-16/AD-20, ticket 04): comma-separated web
# origins allowed to call /graphql and /api/stream from a browser. Blank =
# no cross-origin allowed (safe pre-cutover default); epic P2-8 sets it to
# the deployed Pages origin. Read once at boot (initializer).
# CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Deployed stack (AD-20: api → Render docker, DB → Neon Postgres 17) —
# prod-only names the blueprint does NOT carry as fixed values. render.yaml
# (repo root) wires everything above plus the entries below; this section is
# the text contract for what each one does and why the defaults are as they
# are. Source of truth: grep ENV[ in backend/app + backend/config.
# ---------------------------------------------------------------------------

# Rails runtime. RAILS_ENV=production is fixed in the blueprint (and baked
# into backend/Dockerfile). RAILS_LOG_LEVEL defaults to "info" (production.rb).
# PORT is injected by Render and bound by config/puma.rb — never set it.
# RAILS_ENV=production

# Rails secrets base (Rails 7.1+ reads the ENV before the encrypted
# credentials; no config/master.key is committed). render.yaml generates a
# random value once; outside Render set a real random secret (bin/rails secret).
# SECRET_KEY_BASE=
# (Alternative posture: keep credentials + RAILS_MASTER_KEY instead. Not this
# envelope's choice — both must never be set at once.)

# Process shape. Deliberately NOT set on the deployed service — the shipped
# defaults ARE the pool-arithmetic contract: puma web threads = 3 (puma.rb
# fetch default) + Solid Queue worker threads = 1 (config/queue.yml) +
# dispatcher = 1 share ONE ActiveRecord pool sized by max_connections, whose
# fetch default (5, database.yml) exactly fits. Setting RAILS_MAX_THREADS
# moves BOTH the web-thread count AND the pool size — a mismatch strands the
# queue's threads without a connection (ConnectionTimeoutError under scan +
# request overlap). WEB_CONCURRENCY stays unset = one puma worker (free-tier
# memory, single-instance posture). PIDFILE is available to puma.rb but not
# used by the Render boot.
# RAILS_MAX_THREADS=
# WEB_CONCURRENCY=
# PIDFILE=

# Solid Queue supervisor (in-process with puma, AD-19). SOLID_QUEUE_IN_PUMA=1
# is fixed in the blueprint — unset, the plugin no-ops and the recurring
# due_scan silently never runs. JOB_CONCURRENCY (worker processes, default 1)
# and SOLID_QUEUE_POLLING_INTERVAL (seconds, default 10) rarely need touching:
# a smaller polling interval is NOT a throughput lever, it keeps Neon awake
# through idle windows (AD-19 bans that).
# SOLID_QUEUE_IN_PUMA=1
# JOB_CONCURRENCY=1
# SOLID_QUEUE_POLLING_INTERVAL=10

# BACKEND_DATABASE_PASSWORD exists only as database.yml's non-URL fallback for
# the production stanza — the envelope always sets DATABASE_URL (Neon direct,
# non-pooled, sslmode=require), so it stays unset everywhere this repo deploys.
# BACKEND_DATABASE_PASSWORD=
