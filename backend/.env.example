# The api's config surface is ENV-only (AD-12/AD-20). In local dev,
# backend/.dockerdev/compose.yaml sets these — this file documents the contract.
DATABASE_URL=postgres://postgres:postgres@db:5432/backend_development
RAILS_ENV=development
# Session-token signing secret (HS256) — Accounts::TokenCodec (AD-15, epic
# P2-2 ticket 01). The dev compose wires a fixed dev-only default; outside
# dev, set a real random secret (e.g. `rails secret`). Rotating it invalidates
# every outstanding token (stateless — AD-15 accepted risk).
JWT_SECRET=
# Login rate limiting (AD-15, epic P2-2 ticket 02) — Accounts::LoginRateLimiter.
# Both optional: when absent, blank, or garbage they fall back to the defaults
# shown (threshold = admitted login attempts per email per fixed window;
# window = window length in seconds). The limiter also sheds untracked keys
# above a hard in-memory cap (MAX_KEYS, code constant — not ENV-configurable).
# LOGIN_RATE_LIMIT_THRESHOLD=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Demo account seeded by db/seeds.rb (epic P2-2 ticket 03) — idempotent on
# every db:seed run. DEMO_EMAIL is downcased before create; DEMO_PASSWORD
# must be at least 8 characters (register-command parity). Dev/test fall
# back to demo@synapse.test / demo-password when these are absent or blank;
# production fails fast instead — set real values there.
DEMO_EMAIL=
DEMO_PASSWORD=
# Object storage (AD-13, epic P2-6 ticket 01) — ActiveStorage → S3-compatible
# endpoints. dev/test run the compose minio service: endpoint/bucket are
# pinned in backend/config/storage.yml (endpoint http://minio:9000, bucket
# synapse-materials) and access/secret fall back to the dev defaults
# synapse-dev / synapse-dev-password (compose's MINIO_ROOT_USER/PASSWORD must
# stay aligned). Production runs Cloudflare R2 — every value MUST come from
# ENV there with NO defaults; config/environments/production.rb fails fast at
# boot when any of the four is missing. Provisioning: epic P2-6 ticket 03.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
