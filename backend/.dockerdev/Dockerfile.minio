# The pinned MinIO image is gone from every registry: MinIO archived its
# community distribution in late 2025 (docker.io repo removed, quay/ghcr
# 401/403, dl.min.io 410, no GitHub release binaries) — and the release's OWN
# Dockerfile is dead too (it bases FROM minio/minio:latest, the same removed
# repo). This mirrors ci.yml's e2e-job build (the proven recipe): compile the
# pinned server release + a pinned mc client from source, then assemble a
# minimal runtime image carrying curl (the compose healthcheck) and mc (the
# minio-init bucket bootstrap), tagged exactly what
# backend/.dockerdev/compose.yaml expects. Run via `just minio-image`.
#
# minio's go.mod pins toolchain go1.24.8 for this release; GOTOOLCHAIN=auto
# uses the builder's newer Go natively (>= 1.24.8) and only downloads when it
# can't. mc's newest release tag predates the minio pin (mc stopped tagging
# in Aug 2025 — same archive timeline); alias/mb are stable surface, so the
# pin only needs to exist, not to match.
#
# Network note: this release does NOT vendor its deps, so module downloads
# are the flaky part on filtered networks — proxy.golang.org died mid-zip
# here after ~15 min of healthy downloads (2026-11-06), and on polluted-DNS
# days even base-image metadata resolution against registry-1.docker.io
# times out (same failure class as the epic-00 Docker Hub DNS pollution).
# Each phase is its own RUN layer, so a failed download only re-runs its
# phase on retry. Escape hatches, both read by the justfile recipe and both
# no-ops on clean networks: SYNAPSE_GOPROXY swaps the Go module chain (e.g.
# `SYNAPSE_GOPROXY=https://goproxy.cn,direct just minio-image`), and
# SYNAPSE_DOCKER_MIRROR re-points the two base images at a pull-through
# mirror (e.g. `SYNAPSE_DOCKER_MIRROR=https://docker.m.daocloud.io just
# minio-image`). CI never builds this file (its host build uses the default
# chain on clean GitHub runners).
ARG MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z
ARG MC_RELEASE=RELEASE.2025-08-13T08-35-41Z
ARG GO_IMAGE=golang:1.25-bookworm
ARG RUN_IMAGE=ubuntu:24.04

FROM ${GO_IMAGE} AS build
ARG MINIO_RELEASE
ARG MC_RELEASE
ARG GOPROXY
ENV GOPROXY=${GOPROXY:-https://proxy.golang.org,direct}
RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/*
# Each phase its own layer (see the network note). go build must run from
# INSIDE the module dir — an external path from a non-module cwd fails
# ("cannot find main module"; ci.yml lesson).
RUN git clone --depth 1 --branch "${MINIO_RELEASE}" https://github.com/minio/minio.git /src/minio
RUN cd /src/minio \
  && GOTOOLCHAIN=auto CGO_ENABLED=0 go mod download
RUN mkdir -p /out \
  && cd /src/minio \
  && GOTOOLCHAIN=auto CGO_ENABLED=0 go build -o /out/minio .
RUN git clone --depth 1 --branch "${MC_RELEASE}" https://github.com/minio/mc.git /src/mc
RUN cd /src/mc \
  && GOTOOLCHAIN=auto CGO_ENABLED=0 go mod download
RUN cd /src/mc \
  && GOTOOLCHAIN=auto CGO_ENABLED=0 go build -o /out/mc .

FROM ${RUN_IMAGE}
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/minio /usr/bin/minio
COPY --from=build /out/mc /usr/bin/mc
RUN chmod +x /usr/bin/minio /usr/bin/mc
EXPOSE 9000
ENTRYPOINT ["/usr/bin/minio"]
