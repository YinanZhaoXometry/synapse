# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Temporary files generated by build tools or test suites
.DS_Store
/.bundle
/db/*.sqlite3*
/db/*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep

# Ignore build outputs and dependencies.
/vendor/bundle

# Ignore master key for decrypting credentials and more.
/config/master.key

# Generated GraphQL introspection JSON — the committed contract is
# schema.graphql (AD-17); never ignore that one.
/schema.json

# Coverage and RSpec example persistence
/coverage
/spec/examples.txt

# Environment files — config is ENV-only (AD-12/AD-20); .env.example is the
# committed template.
/.env
/.env.*
!/.env.example

# Local-only compose overrides (dev secrets — OQ-4 provider key etc.)
/.dockerdev/compose.override.yaml
