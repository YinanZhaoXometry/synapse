source "https://rubygems.org"

# Rails 8.1 API-only (AD-12). Other gems floor-pin (~>); Gemfile.lock holds
# the exact versions. Rails is pinned exact at scaffold per the spine stack table (≥ 8.1.4).
gem "rails", "8.1.4"
# Postgres 17 everywhere (AD-13)
gem "pg", "~> 1.7.0"
# Spine stack table: puma 7.x
gem "puma", "~> 7.2.1"
# GraphQL-first api surface (AD-12); spine stack table: graphql-ruby 2.5.x
gem "graphql", "~> 2.5.26"
# Safe-migration guard on every schema change (AD-13)
gem "strong_migrations", "~> 2.8.0"
# Command layer (AD-12): dry-initializer options + dry-monads Result.
# Runtime deps — default group, not dev/test. Spine stack table: "current
# stable at scaffold" (floor pins; Gemfile.lock holds the exact versions).
gem "dry-initializer", "~> 3.2"
gem "dry-monads", "~> 1.11"
# Auth primitives (AD-15): bcrypt backs has_secure_password; jwt mints the
# stateless HS256 session tokens. Runtime deps — default group, not dev/test.
# "Current stable at scaffold" floor pins; Gemfile.lock holds the exact versions.
gem "bcrypt", "~> 3.1.22"
gem "jwt", "~> 3.3.0"
# Object storage (AD-13): ActiveStorage's S3 service targets minio in dev
# (compose R2 stand-in) and Cloudflare R2 in production. Runtime dep — default
# group, not dev/test. Spine stack table posture: floor pin at current stable
# (rubygems 1.237.0, verified 2026-11-04); Gemfile.lock holds the exact
# version. No other aws-sdk gems — presign needs s3 only (epic P2-6 kickoff).
gem "aws-sdk-s3", "~> 1.237.0"

# Solid Queue (AD-19, epic P2-7 ticket 01): the DB-backed job queue, running
# IN-PROCESS with puma (the puma plugin, gated by SOLID_QUEUE_IN_PUMA) — no
# separate worker service, no Redis. Spine stack table posture: floor pin at
# current stable (rubygems 1.7.2, verified 2026-11-04); Gemfile.lock holds the
# exact version. The queue shares the app's Postgres via DATABASE_URL;
# production must point that URL at Neon's DIRECT (non-pooled) endpoint —
# Solid Queue's polling dislikes transaction-mode pooling (AD-19).
gem "solid_queue", "~> 1.7.2"

# CORS (AD-16/AD-20, epic P2-5 ticket 04 — kickoff delta 2): the web origin
# allowlist for the api's two browser-facing surfaces, /graphql and
# /api/stream. Origins come from CORS_ORIGIN (comma-separated; blank = no
# cross-origin allowed — the safe pre-cutover default; epic P2-8 sets it).
gem "rack-cors", "~> 2.0.2"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Dev-local secrets (2026-11-06 owner decision — the qc-center-api posture):
# the Rails process loads backend/.env itself in development, so live AI
# config rides the plain single-file stack — no compose override file, and
# bare `just up` carries PROVIDER_KEY. Deliberately development-ONLY:
# test never loads .env, so provider-config-dependent specs stay
# deterministic locally (CI has no .env either — parity by construction);
# production injects ENV (Render) and must not see the file. dotenv never
# overwrites vars already in ENV, so compose-injected infra values
# (DATABASE_URL, RAILS_ENV, JWT_SECRET, DEMO_*) always win over the file.
group :development do
  gem "dotenv-rails", "~> 3.1"
end

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
  gem "rubocop-rails-omakase", require: false

  # Spine stack table: rspec-rails + factory_bot_rails
  gem "rspec-rails", "~> 8.0.4"
  gem "factory_bot_rails", "~> 6.5.1"

  # Coverage measurement (epic P3-17 ticket 01): line+branch over app/, started
  # at the top of spec_helper — it must boot before Rails does. The floor is a
  # ratchet pinned to the measured baseline (epic-17 decision 7), not a target.
  gem "simplecov", "~> 0.22.0", require: false
end
